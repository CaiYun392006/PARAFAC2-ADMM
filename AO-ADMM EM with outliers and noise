        E_k = np.zeros((I, J_list[k]))
        stripe_cols = np.random.choice(J_list[k], size=int(J_list[k] * 0.1),replace=False)
        E_k[:, stripe_cols] = outlier_magnitude * np.random.randn(I, len(stripe_cols))
        E_k[W_list[k] == 0] = 0.0
        E_true.append(E_k)

    X_clean_true = [A_true @ np.diag(D_true[k]) @ B_true[k].T for k in range(K)]

    sigma_list = [0.0, 0.0001, 0.01, 0.1]
