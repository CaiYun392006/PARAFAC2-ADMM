    results = {}

    for sigma in sigma_list:
        X_full = [X_clean_true[k] + sigma * base_noise[k] + E_true[k] for k in range(K)]

        A_est, B_est, D_est, E_est, norm_X, X_recon, sse_list, rel_miss, outlier_sp = parafac2_admm_em(
