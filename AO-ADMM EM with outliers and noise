        )
        
        true_miss_vec = np.concatenate([(X_clean_true[k] / norm_X)[W_list[k] == 0] for k in range(K)])
        fit_miss_vec = np.concatenate([X_recon[k][W_list[k] == 0] for k in range(K)])
        r_val = np.corrcoef(true_miss_vec, fit_miss_vec)[0, 1] if np.std(true_miss_vec) > 1e-12 else 0.0

        results[sigma] = {
            'sse_list': sse_list,
